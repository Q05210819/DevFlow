# Optional cloud-chat configuration for the Compose model-worker only.
#
# Copy this file to infra/chat.env (untracked) and mount a rotated key file at
# /run/devflow-secrets/chat_api_key. Cloud chat stays disabled while this file
# is absent or CHAT_CLOUD_ENABLED is not "true".
#
# The price sheet is mandatory: there is no default currency, amount or price.
# A missing, expired or inconsistent sheet makes the deployment fail to start.
#
# CHAT_CLOUD_ENABLED=true
# CHAT_API_KEY_FILE=/run/devflow-secrets/chat_api_key
# CHAT_BUDGET_CURRENCY=USD
# CHAT_RUN_BUDGET=1.000000
# CHAT_MONTH_BUDGET=20.000000
# CHAT_BUDGET_MINOR_UNIT=0.000001
# CHAT_PRICING_VERSION=operator-pricing-v1
# CHAT_PRICING_VALID_UNTIL=2027-01-01T00:00:00+00:00
# CHAT_INPUT_PRICE_PER_MILLION=0.500000
# CHAT_OUTPUT_PRICE_PER_MILLION=1.500000
