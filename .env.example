# Copy to .env at repository root. Never commit real secrets.
# Host API: uv --directory backend run --env-file ../.env --no-sync uvicorn ...
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Production Compose requires a real HTTPS origin; dev overlay fixes localhost:8080.
# Replace these DIFFERENT IDs before real GitHub use.
BOOTSTRAP_ADMIN_GITHUB_ID=1
GITHUB_APP_ID=1
GITHUB_CLIENT_ID=replace-with-client-id
GITHUB_ALLOWED_INSTALLATION_IDS=[1]
DEVFLOW_IMAGE_TAG=local
# Absolute host directory holding seven secret files; see docs/operations/deployment.md.
# Windows: D:/devflow-secrets ; Linux: /srv/devflow-secrets
DEVFLOW_SECRETS_DIR=/srv/devflow-secrets

# Host process only; Compose reads the mounted database_url file instead.
# DATABASE_URL=postgresql+psycopg://devflow:URL_ENCODED_PASSWORD@127.0.0.1:55440/devflow
# GITHUB_CLIENT_SECRET_FILE=D:/devflow-secrets/github_client_secret
# GITHUB_PRIVATE_KEY_FILE=D:/devflow-secrets/github_private_key
# GITHUB_WEBHOOK_SECRET_FILE=D:/devflow-secrets/github_webhook_secret
# CREDENTIAL_ENCRYPTION_KEY_FILE=D:/devflow-secrets/credential_encryption_key
# APP_SIGNING_KEY_FILE=D:/devflow-secrets/app_signing_key

# Defaults: OAuth state 600s; session 28800s; permission cache <=60s.
# Worker defaults: 4 concurrent, 3 attempts, retry delays 10/30s,
# lease 30s, heartbeat 10s, attempt timeout 120s.
# WORKER_CONCURRENCY=4
