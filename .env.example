# Copy to .env at repository root. Never commit real secrets.
# Host API: uv --directory backend run --env-file ../.env --no-sync uvicorn ...
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Production Compose requires a real HTTPS origin; dev overlay fixes localhost:8080.
# Replace these DIFFERENT IDs before real GitHub use.
BOOTSTRAP_ADMIN_GITHUB_ID=1
GITHUB_APP_ID=1
GITHUB_CLIENT_ID=replace-with-client-id
GITHUB_ALLOWED_INSTALLATION_IDS=[1]
DEVFLOW_IMAGE_TAG=local
# Absolute host directory holding nine secret files; see docs/operations/deployment.md.
# Windows: D:/devflow-secrets ; Linux: /srv/devflow-secrets
DEVFLOW_SECRETS_DIR=/srv/devflow-secrets

# Host process only; Compose reads the mounted database_url file instead.
# DATABASE_URL=postgresql+psycopg://devflow:URL_ENCODED_PASSWORD@127.0.0.1:55440/devflow
# GITHUB_CLIENT_SECRET_FILE=D:/devflow-secrets/github_client_secret
# GITHUB_PRIVATE_KEY_FILE=D:/devflow-secrets/github_private_key
# GITHUB_WEBHOOK_SECRET_FILE=D:/devflow-secrets/github_webhook_secret
# CREDENTIAL_ENCRYPTION_KEY_FILE=D:/devflow-secrets/credential_encryption_key
# APP_SIGNING_KEY_FILE=D:/devflow-secrets/app_signing_key

# Defaults: OAuth state 600s; session 28800s; permission cache <=60s.
# Worker defaults: 4 concurrent, 3 attempts, retry delays 10/30s,
# lease 30s, heartbeat 10s, attempt timeout 120s.
# WORKER_CONCURRENCY=4

# 2A fact synchronization (also passed to API/migrate/Worker by Compose).
# Keep approved request/time bounds; reduce budgets to constrain load.
# SYNC_CONCURRENCY=2
# SYNC_UNIT_REQUESTS=5
# SYNC_UNIT_SECONDS=120
# SYNC_ROUND_REQUESTS=10000
# SYNC_ROUND_SECONDS=86400
# SYNC_INTERVAL_SECONDS=900
# SYNC_RECONCILE_SECONDS=86400
# SYNC_HISTORY_DAYS=90
# SYNC_ACTIONS_DAYS=30
# SYNC_OVERLAP_SECONDS=300

# Workspace: Git >=2.43. Host API and Worker must use the same owned absolute root.
# Compose fixes /usr/bin/git and /var/lib/devflow/workspace (API RO / Worker RW).
# WORKSPACE_GIT_EXECUTABLE=C:/Program Files/Git/cmd/git.exe
# WORKSPACE_CACHE_ROOT=D:/devflow-workspace
# Soft byte budgets, not filesystem quotas; production requires a constrained volume.
# WORKSPACE_REPOSITORY_BYTES=2147483648
# WORKSPACE_TOTAL_BYTES=21474836480
# WORKSPACE_UNUSED_DAYS=7
# WORKSPACE_ORPHAN_GRACE_SECONDS=600

# 3B local index and model worker. The API and ordinary Worker never install or
# load torch; only the separate model-worker image uses the optional models extra.
# DEVFLOW_MODEL_DIR is an absolute HOST directory mounted read-only at /models.
# It must be readable by UID 10001 and must not contain checkouts or secrets.
# Windows development example: D:/devflow-models
# DEVFLOW_MODEL_DIR=/srv/devflow-models
# Container paths must be absolute and inside that mount. These are explicit
# choices, not inferred from the platform or a previous run.
# MODEL_EMBEDDING_PATH=/models/bge-m3
# MODEL_RERANKER_PATH=/models/bge-reranker-v2-m3
# KNOWLEDGE_TOKENIZER_PATH=/models/bge-m3
# CPU is valid only as an explicit selection with measured latency/memory.
# MODEL_DEVICE=cpu
# MODEL_DTYPE=float32
# MODEL_STARTUP_TIMEOUT_SECONDS=1800
# MODEL_DRAIN_TIMEOUT_SECONDS=120

# Host process only; Compose points API/Worker/model-worker at http://milvus:19530.
# Development Milvus publishes 127.0.0.1:19531 when started with --profile milvus.
# MILVUS_URI=http://127.0.0.1:19531

# 3D private chat. Cloud calls stay disabled by default; local retrieval and
# history work without a provider. Enabling requires a rotated key file plus a
# complete positive run/month budget, currency, minor unit and valid price sheet.
# The model, base URL and parameter version are fixed in code, not configured.
# CHAT_CLOUD_ENABLED=true
# CHAT_API_KEY_FILE=D:/devflow-secrets/chat_api_key
# CHAT_BUDGET_CURRENCY=USD
# CHAT_RUN_BUDGET=1.000000
# CHAT_MONTH_BUDGET=20.000000
# CHAT_BUDGET_MINOR_UNIT=0.000001
# CHAT_PRICING_VERSION=operator-pricing-v1
# CHAT_PRICING_VALID_UNTIL=2027-01-01T00:00:00+00:00
# CHAT_INPUT_PRICE_PER_MILLION=0.500000
# CHAT_OUTPUT_PRICE_PER_MILLION=1.500000
# The official LangGraph saver schema is deployed explicitly, never on startup.
# uv --directory backend run --env-file ../.env --no-sync python -m devflow.chat.checkpoints --setup
