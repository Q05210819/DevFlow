# Local API startup works without a database or GitHub App.
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:3000

# Required for database-backed features and production deployment.
# DATABASE_URL=postgresql+psycopg://devflow:change-me@localhost:5432/devflow
# BOOTSTRAP_ADMIN_GITHUB_ID=123456
# GITHUB_APP_ID=123456
# GITHUB_CLIENT_ID=Iv1.example
# GITHUB_ALLOWED_INSTALLATION_IDS=[123456]
# GITHUB_CLIENT_SECRET_FILE=/run/secrets/github_client_secret
# GITHUB_PRIVATE_KEY_FILE=/run/secrets/github_private_key
# GITHUB_WEBHOOK_SECRET_FILE=/run/secrets/github_webhook_secret
# CREDENTIAL_ENCRYPTION_KEY_FILE=/run/secrets/credential_encryption_key
# APP_SIGNING_KEY_FILE=/run/secrets/app_signing_key

# Defaults: OAuth state 10 minutes, session 8 hours, permission cache at most 60 seconds.
# OAUTH_STATE_TTL_SECONDS=600
# SESSION_TTL_SECONDS=28800
# PERMISSION_CACHE_TTL_SECONDS=60
# JOB_MAX_ATTEMPTS=3
# JOB_RETRY_FIRST_SECONDS=10
# JOB_RETRY_SECOND_SECONDS=30
# JOB_LEASE_SECONDS=30
# JOB_HEARTBEAT_SECONDS=10
# JOB_ATTEMPT_TIMEOUT_SECONDS=120
# WORKER_CONCURRENCY=4
